    };

    float3 phong(float3 normal_1, float3 lightDir)
    {
        float _23 = dot(lightDir, normal_1);
        if (_23 < 0.0f)
        {
            return float3(0.20000000298023223876953125f, 0.300000011920928955078125f, 0.4000000059604644775390625f);
