    struct SPIRV_Cross_Input
    {
        float3 normal : TEXCOORD0;
        float4 color : TEXCOORD1;
        nointerpolation float2 cell_axial : TEXCOORD2;
    };

    struct SPIRV_Cross_Output
    {
