dynamic_shader_desc :: proc "c" (backend: sg.Backend) -> sg.Shader_Desc {
    desc: sg.Shader_Desc
    desc.label = "dynamic_shader"
    #partial switch backend {
    case .GLCORE:
        desc.vertex_func.source = transmute(cstring)&vs_source_glsl430
        desc.vertex_func.entry = "main"
        desc.fragment_func.source = transmute(cstring)&fs_source_glsl430
        desc.fragment_func.entry = "main"
        desc.attrs[0].base_type = .FLOAT
        desc.attrs[0].glsl_name = "instance_position"
        desc.attrs[1].base_type = .FLOAT
        desc.attrs[1].glsl_name = "instance_axial"
        desc.attrs[2].base_type = .FLOAT
        desc.attrs[2].glsl_name = "position"
        desc.attrs[3].base_type = .FLOAT
        desc.attrs[3].glsl_name = "vertex_axial"
        desc.uniform_blocks[1].stage = .VERTEX
        desc.uniform_blocks[1].layout = .STD140
        desc.uniform_blocks[1].size = 64
        desc.uniform_blocks[1].glsl_uniforms[0].type = .FLOAT4
        desc.uniform_blocks[1].glsl_uniforms[0].array_count = 4
        desc.uniform_blocks[1].glsl_uniforms[0].glsl_name = "vs_params"
        desc.views[0].texture.stage = .VERTEX
        desc.views[0].texture.image_type = ._2D
        desc.views[0].texture.sample_type = .FLOAT
        desc.views[0].texture.multisampled = false
        desc.samplers[0].stage = .VERTEX
        desc.samplers[0].sampler_type = .FILTERING
        desc.texture_sampler_pairs[0].stage = .VERTEX
        desc.texture_sampler_pairs[0].view_slot = 0
        desc.texture_sampler_pairs[0].sampler_slot = 0
        desc.texture_sampler_pairs[0].glsl_name = "heightmap_smp"
    case .D3D11:
        desc.vertex_func.source = transmute(cstring)&vs_source_hlsl5
        desc.vertex_func.d3d11_target = "vs_5_0"
        desc.vertex_func.entry = "main"
        desc.fragment_func.source = transmute(cstring)&fs_source_hlsl5
        desc.fragment_func.d3d11_target = "ps_5_0"
        desc.fragment_func.entry = "main"
        desc.attrs[0].base_type = .FLOAT
        desc.attrs[0].hlsl_sem_name = "TEXCOORD"
        desc.attrs[0].hlsl_sem_index = 0
        desc.attrs[1].base_type = .FLOAT
        desc.attrs[1].hlsl_sem_name = "TEXCOORD"
        desc.attrs[1].hlsl_sem_index = 1
        desc.attrs[2].base_type = .FLOAT
        desc.attrs[2].hlsl_sem_name = "TEXCOORD"
        desc.attrs[2].hlsl_sem_index = 2
        desc.attrs[3].base_type = .FLOAT
        desc.attrs[3].hlsl_sem_name = "TEXCOORD"
        desc.attrs[3].hlsl_sem_index = 3
        desc.uniform_blocks[1].stage = .VERTEX
        desc.uniform_blocks[1].layout = .STD140
        desc.uniform_blocks[1].size = 64
        desc.uniform_blocks[1].hlsl_register_b_n = 1
        desc.views[0].texture.stage = .VERTEX
        desc.views[0].texture.image_type = ._2D
        desc.views[0].texture.sample_type = .FLOAT
        desc.views[0].texture.multisampled = false
        desc.views[0].texture.hlsl_register_t_n = 0
        desc.samplers[0].stage = .VERTEX
        desc.samplers[0].sampler_type = .FILTERING
        desc.samplers[0].hlsl_register_s_n = 0
        desc.texture_sampler_pairs[0].stage = .VERTEX
        desc.texture_sampler_pairs[0].view_slot = 0
        desc.texture_sampler_pairs[0].sampler_slot = 0
    }
    return desc
}
erosion_shader_desc :: proc "c" (backend: sg.Backend) -> sg.Shader_Desc {
    desc: sg.Shader_Desc
    desc.label = "erosion_shader"
    #partial switch backend {
    case .GLCORE:
        desc.compute_func.source = transmute(cstring)&cs_erosion_source_glsl430
        desc.compute_func.entry = "main"
        desc.views[0].texture.stage = .COMPUTE
        desc.views[0].texture.image_type = ._2D
        desc.views[0].texture.sample_type = .SINT
        desc.views[0].texture.multisampled = false
        desc.views[1].storage_image.stage = .COMPUTE
        desc.views[1].storage_image.image_type = ._2D
        desc.views[1].storage_image.access_format = .RGBA32F
        desc.views[1].storage_image.writeonly = true
        desc.views[1].storage_image.glsl_binding_n = 0
        desc.samplers[0].stage = .COMPUTE
        desc.samplers[0].sampler_type = .NONFILTERING
        desc.texture_sampler_pairs[0].stage = .COMPUTE
        desc.texture_sampler_pairs[0].view_slot = 0
        desc.texture_sampler_pairs[0].sampler_slot = 0
        desc.texture_sampler_pairs[0].glsl_name = "base_map_ismp"
    case .D3D11:
        desc.compute_func.source = transmute(cstring)&cs_erosion_source_hlsl5
        desc.compute_func.d3d11_target = "cs_5_0"
        desc.compute_func.entry = "main"
        desc.views[0].texture.stage = .COMPUTE
        desc.views[0].texture.image_type = ._2D
        desc.views[0].texture.sample_type = .SINT
        desc.views[0].texture.multisampled = false
        desc.views[0].texture.hlsl_register_t_n = 0
        desc.views[1].storage_image.stage = .COMPUTE
        desc.views[1].storage_image.image_type = ._2D
        desc.views[1].storage_image.access_format = .RGBA32F
        desc.views[1].storage_image.writeonly = true
        desc.views[1].storage_image.hlsl_register_u_n = 0
        desc.samplers[0].stage = .COMPUTE
        desc.samplers[0].sampler_type = .NONFILTERING
        desc.samplers[0].hlsl_register_s_n = 0
        desc.texture_sampler_pairs[0].stage = .COMPUTE
        desc.texture_sampler_pairs[0].view_slot = 0
        desc.texture_sampler_pairs[0].sampler_slot = 0
    }
    return desc
}
